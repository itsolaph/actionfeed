# Service
PORT=8787
NODE_ENV=production          # production => https-only webhooks + SSRF blocks
DB_PATH=actionfeed.sqlite
RPC_URL=https://base-rpc.publicnode.com
START_BLOCK=0                # first block to backfill from
CONFIRMATIONS=20             # reorg safety depth
POLL_MS=15000

# Keeper (optional; disabled unless both are set). Dry-run is ON unless KEEPER_DRY_RUN=0.
ACTIONFEED_ADDRESS=          # deployed ActionFeed contract
KEEPER_KEY_FILE=             # path to a file containing the keeper private key (never commit it)
KEEPER_DRY_RUN=1
KEEPER_MAX_GWEI=1
KEEPER_MAX_GAS=1500000
BUILDER_CODE=                # your Base Builder Code (ERC-8021); get one at base.dev

# Contracts / fork tests
BASE_RPC_URL=https://base-rpc.publicnode.com
