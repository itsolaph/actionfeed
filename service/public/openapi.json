{
  "openapi": "3.0.3",
  "info": { "title": "ActionFeed API", "version": "0.1.0", "description": "Corporate-action index for B20 tokenized stocks on Base. Multipliers are decimal strings scaled by 1e18. Independent project; not investment advice.", "license": { "name": "MIT" } },
  "paths": {
    "/health": { "get": { "summary": "Liveness and index cursor", "responses": { "200": { "description": "ok" } } } },
    "/v1/tokens": { "get": { "summary": "All known tokens", "responses": { "200": { "description": "tokens", "content": { "application/json": { "schema": { "type": "object", "properties": { "tokens": { "type": "array", "items": { "$ref": "#/components/schemas/Token" } } } } } } } } } },
    "/v1/tokens/{address}": { "get": { "summary": "One token", "parameters": [{ "$ref": "#/components/parameters/address" }], "responses": { "200": { "description": "token" }, "400": { "description": "bad address" }, "404": { "description": "unknown token" } } } },
    "/v1/tokens/{address}/multiplier": { "get": { "summary": "Multiplier in force at a time", "parameters": [{ "$ref": "#/components/parameters/address" }, { "name": "at", "in": "query", "schema": { "type": "integer" }, "description": "unix seconds; default now" }], "responses": { "200": { "description": "multiplier; known=false if outside indexed window" } } } },
    "/v1/tokens/{address}/history": { "get": { "summary": "Canonical history (cancelled dropped, dated by effectiveAt) and raw events", "parameters": [{ "$ref": "#/components/parameters/address" }], "responses": { "200": { "description": "history" } } } },
    "/v1/actions/upcoming": { "get": { "summary": "Pending multiplier changes, soonest first", "responses": { "200": { "description": "actions" } } } },
    "/v1/actions/recent": { "get": { "summary": "Latest events", "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 200 } }], "responses": { "200": { "description": "events" } } } },
    "/v1/subscriptions": { "post": { "summary": "Create a signed webhook subscription (secret returned once)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" }, "tokens": { "type": "array", "items": { "type": "string" } }, "events": { "type": "array", "items": { "type": "string", "enum": ["scheduled", "cancelled", "effective", "paused", "announcement"] } }, "leads": { "type": "array", "items": { "type": "string", "enum": ["T-24h", "T-1h", "T-5m"] } } } } } } }, "responses": { "201": { "description": "id and secret" }, "400": { "description": "invalid or blocked url" } } } },
    "/v1/subscriptions/{id}/deliveries": { "get": { "summary": "Delivery log (Bearer subscription secret)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "security": [{ "secret": [] }], "responses": { "200": { "description": "deliveries" }, "401": { "description": "unauthorized" } } } },
    "/v1/subscriptions/{id}": { "delete": { "summary": "Deactivate a subscription", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "security": [{ "secret": [] }], "responses": { "200": { "description": "ok" } } } },
    "/v1/stream": { "get": { "summary": "Server-Sent Events of newly indexed events", "responses": { "200": { "description": "text/event-stream" } } } }
  },
  "components": {
    "securitySchemes": { "secret": { "type": "http", "scheme": "bearer" } },
    "parameters": { "address": { "name": "address", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" } } },
    "schemas": { "Token": { "type": "object", "properties": { "address": { "type": "string" }, "symbol": { "type": "string", "nullable": true }, "decimals": { "type": "integer", "nullable": true }, "multiplier": { "type": "string", "nullable": true }, "pending": { "type": "object", "nullable": true, "properties": { "multiplier": { "type": "string" }, "effectiveAt": { "type": "integer" } } } } } }
  }
}
